<UserControl
    x:Class="Guardian.LumenOrb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="28" Height="28">
    <!-- Gradient orb from the Lumen logo: rose -> violet -> cyan with a soft white core -->
    <Viewbox>
        <Grid Width="32" Height="32">
            <Ellipse Width="28" Height="28">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#ff2e55" Offset="0" />
                        <GradientStop Color="#8b6bff" Offset="0.55" />
                        <GradientStop Color="#38d0ff" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="20" Height="28" HorizontalAlignment="Left" Margin="2,0,0,0" Fill="#48FFFFFF" />
            <Ellipse Width="16" Height="16" Fill="#33FFFFFF" />
            <Ellipse Width="12" Height="12" Fill="#E6FFFFFF" />
        </Grid>
    </Viewbox>
</UserControl>
