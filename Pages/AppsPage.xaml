<Page
    x:Class="Guardian.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Guardian.Services">
    <Grid Margin="40,28,40,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="SOFTWARE" Style="{StaticResource EyebrowStyle}" />
            <TextBlock Text="App updates" Style="{StaticResource TitleTextBlockStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="CheckButton" Content="Check for updates" Click="Check_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="UpdateSelectedButton" Content="Update selected" Click="UpdateSelected_Click" IsEnabled="False" />
            <Button x:Name="UpdateAllButton" Content="Update all" Click="UpdateAll_Click" IsEnabled="False" />
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="2">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <TextBlock x:Name="NoteText" Foreground="{StaticResource FaintBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
        <ListView x:Name="AppsList" Grid.Row="3" ItemsSource="{x:Bind Apps}" SelectionMode="Multiple"
                  SelectionChanged="AppsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:AppUpdate">
                    <Grid Padding="0,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource DisplayBoldFont}" FontSize="22" />
                            <TextBlock Text="{x:Bind Id}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind VersionText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="Installer output" />
    </Grid>
</Page>
