<Page
    x:Class="Guardian.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Guardian.Pages">
    <Grid Margin="40,28,40,20" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="TOOLBOX" Style="{StaticResource EyebrowStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Button x:Name="BackButton" Visibility="Collapsed" Click="Back_Click" VerticalAlignment="Center" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="All tools" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="TitleText" Text="System tools" Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer x:Name="TileScroll" Grid.Row="1">
            <GridView x:Name="TileGrid" ItemsSource="{x:Bind Tiles}" IsItemClickEnabled="True" SelectionMode="None"
                      ItemClick="Tile_Click" Margin="0,8,0,0">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="m:ToolTile">
                        <Border Style="{StaticResource GlassCard}" Width="138" Height="104" Padding="8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{x:Bind Name}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <Frame x:Name="ToolFrame" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,0" />
    </Grid>
</Page>
