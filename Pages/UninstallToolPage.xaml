<Page
    x:Class="Guardian.Pages.UninstallToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Guardian.Services.Tools">
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"
                   Text="Installed programs. Pick one and press Uninstall to start its own uninstaller; Guardian never deletes program files itself." />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox" PlaceholderText="Search programs" Width="260" TextChanged="Search_TextChanged" />
            <Button x:Name="UninstallButton" Content="Uninstall" Click="Uninstall_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <ListView x:Name="ProgramList" Grid.Row="2" ItemsSource="{x:Bind Items}" SelectionMode="Single"
                  SelectionChanged="ProgramList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:InstalledProgram">
                    <StackPanel Padding="0,6">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
