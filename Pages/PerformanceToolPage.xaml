<Page
    x:Class="Guardian.Pages.PerformanceToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Guardian.Services.Tools">
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="740" HorizontalAlignment="Left"
                   Text="Well-understood Windows settings that can make a PC feel faster, each one a switch you can flip back at any time. The main list never touches security features, Windows services or your files; the clearly marked Advanced section at the bottom does lower protection." />
        <StackPanel Grid.Row="1" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RecommendedButton" Content="Apply recommended" Click="Recommended_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Undo all" Click="UndoAll_Click" />
                <Button Content="Refresh" Click="Refresh_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </StackPanel>
        <ListView Grid.Row="2" ItemsSource="{x:Bind Items}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:PerfTweak">
                    <Grid Padding="0,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Title}" />
                            <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsApplied, Mode=OneWay}" OnContent="On" OffContent="Off"
                                      Toggled="Toggle_Toggled" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Expander Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Advanced: lower security for more speed (at your own risk)">
            <StackPanel Spacing="8">
                <TextBlock TextWrapping="Wrap" Foreground="#FFB84A"
                           Text="These switch off Windows protections. The speed gain is usually small, and your PC becomes easier to attack. Each one needs administrator rights, asks you to confirm, tries to make a restore point first, and can be switched back on here." />
                <ListView ItemsSource="{x:Bind AdvancedItems}" SelectionMode="None" MaxHeight="240">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:PerfTweak">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title}" />
                                    <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsApplied, Mode=OneWay}" OnContent="Protection off" OffContent="Protection on"
                                              Toggled="Toggle_Toggled" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Expander>

        <TextBlock Grid.Row="4" Foreground="{StaticResource FaintBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="740" HorizontalAlignment="Left"
                   Text="Not offered at all: stopping Defender or the firewall, disabling Windows services, and RAM cleaners. They gain almost nothing on a modern PC and mostly leave it exposed or unstable." />
    </Grid>
</Page>
