<Page
    x:Class="Guardian.Pages.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Guardian.Services"
    xmlns:d="using:Guardian.Services.Deep"
    xmlns:g="using:Guardian">
    <Grid>
        <Grid Margin="40,28,40,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4" Margin="0,0,0,12">
                <TextBlock Text="PROTECTION" Style="{StaticResource EyebrowStyle}" />
                <TextBlock Text="Virus scan" Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>

            <Pivot Grid.Row="1">
                <!-- ============ Guardian deep scan ============ -->
                <PivotItem Header="Deep scan">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" MaxWidth="900" HorizontalAlignment="Left"
                                   Text="Guardian's own scanner looks where malware hides and where it survives a reboot: startup entries, scheduled tasks, services, running programs, kernel drivers, temp and AppData folders, and security settings that attackers switch off. It never opens your documents, photos or ID scans, never uploads anything, and never removes anything on its own." />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="DeepButton" Content="Start deep scan" Click="DeepStart_Click" Style="{StaticResource AccentButtonStyle}" />
                            <CheckBox x:Name="IncludeDefender" Content="Also run a Defender quick scan" IsChecked="True" VerticalAlignment="Center" />
                            <CheckBox x:Name="ScanMemory" Content="Scan programs' memory" Checked="ScanMemory_Changed" Unchecked="ScanMemory_Changed" VerticalAlignment="Center"
                                      ToolTipService.ToolTip="Looks inside running programs for known malware. Guardian refuses to do this while EasyAntiCheat, BattlEye, Vanguard or similar is running, because anti-cheat can treat it as cheating and ban the account." />
                            <CheckBox x:Name="ShowLow" Content="Show low-risk items" Checked="ShowLow_Changed" Unchecked="ShowLow_Changed" VerticalAlignment="Center" />
                            <Button Content="Quarantine" Click="ShowQuarantine_Click" />
                        </StackPanel>
                        <TextBlock x:Name="DeepSummary" Grid.Row="2" TextWrapping="Wrap" />

                        <Grid Grid.Row="3" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ListView x:Name="FindingsList" ItemsSource="{x:Bind Findings}" SelectionMode="Single" SelectionChanged="Finding_Selected">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="d:Finding">
                                        <Grid Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind SeverityText}" Foreground="{x:Bind SeverityBrush}" FontSize="11" FontWeight="Bold"
                                                       CharacterSpacing="80" VerticalAlignment="Top" Margin="0,3,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource DisplayBoldFont}" FontSize="21" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="20,16">
                                <Grid>
                                    <TextBlock x:Name="DetailsEmpty" Text="Select an item to see why Guardian flagged it." Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" />
                                    <ScrollViewer x:Name="DetailsScroll" Visibility="Collapsed">
                                        <StackPanel Spacing="10">
                                            <TextBlock x:Name="DetailSeverity" FontSize="11" FontWeight="Bold" CharacterSpacing="100" />
                                            <TextBlock x:Name="DetailTitle" FontFamily="{StaticResource DisplayBoldFont}" FontSize="25" TextWrapping="Wrap" />
                                            <TextBlock Text="WHY IT WAS FLAGGED" Style="{StaticResource CardLabelStyle}" Margin="0,6,0,0" />
                                            <TextBlock x:Name="DetailReasons" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="WHAT TO DO" Style="{StaticResource CardLabelStyle}" Margin="0,6,0,0" />
                                            <TextBlock x:Name="DetailAdvice" TextWrapping="Wrap" />
                                            <TextBlock Text="DETAILS" Style="{StaticResource CardLabelStyle}" Margin="0,6,0,0" />
                                            <TextBlock x:Name="DetailInfo" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" IsTextSelectionEnabled="True" />
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button x:Name="QuarantineButton" Content="Quarantine file" Click="QuarantineFile_Click" Style="{StaticResource AccentButtonStyle}" />
                                                    <Button x:Name="EndButton" Content="End process" Click="EndProcess_Click" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button x:Name="ShowButton" Content="Show in folder" Click="ShowInFolder_Click" />
                                                    <Button x:Name="CheckVtButton" Content="Check on VirusTotal" Click="CheckVt_Click" />
                                                    <Button x:Name="IgnoreButton" Content="Ignore" Click="Ignore_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </PivotItem>

                <!-- ============ Windows Defender ============ -->
                <PivotItem Header="Windows Defender">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="QuickButton" Content="Quick scan" Click="Quick_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="FullButton" Content="Full scan" Click="Full_Click" />
                            <Button x:Name="FolderButton" Content="Scan a folder…" Click="Folder_Click" />
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Detected threats" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Button x:Name="RemoveButton" Content="Remove active threats" Click="Remove_Click" IsEnabled="False" />
                        </StackPanel>
                        <ListView Grid.Row="3" ItemsSource="{x:Bind Threats}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:ThreatInfo">
                                    <StackPanel Padding="0,10" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource DisplayBoldFont}" FontSize="22" />
                                        <TextBlock Text="{x:Bind Resources}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Foreground="{x:Bind StateBrush}">
                                            <Run Text="{x:Bind SeverityText}" /> · <Run Text="{x:Bind StateText}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>

                <!-- ============ VirusTotal ============ -->
                <PivotItem Header="VirusTotal check">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="Hashes the newest executables in a folder and looks the hashes up on VirusTotal as a second opinion. Files are never uploaded. The free API allows 4 lookups per minute, so this is slow by design." />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="VtFolderButton" Content="Choose folder and check…" Click="VtFolder_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="VtCancelButton" Content="Cancel" Click="VtCancel_Click" IsEnabled="False" />
                            <ProgressRing x:Name="VtBusy" IsActive="False" Width="20" Height="20" />
                        </StackPanel>
                        <TextBlock x:Name="VtStatus" Grid.Row="2" />
                        <ListView Grid.Row="3" ItemsSource="{x:Bind VtResults}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:VtResult">
                                    <StackPanel Padding="0,10" Spacing="2">
                                        <TextBlock Text="{x:Bind FileName}" FontFamily="{StaticResource DisplayBoldFont}" FontSize="22" />
                                        <TextBlock Text="{x:Bind VerdictText}" Foreground="{x:Bind VerdictBrush}" />
                                        <TextBlock Text="{x:Bind FilePath}" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>
            </Pivot>
        </Grid>

        <g:ScanOverlay x:Name="Overlay" />
    </Grid>
</Page>
