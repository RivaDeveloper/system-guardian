<Page
    x:Class="Guardian.Pages.SysInfoToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Guardian.Pages">
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh" Click="Refresh_Click" />
            <Button Content="Copy to clipboard" Click="Copy_Click" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{x:Bind Rows}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:InfoRow">
                    <Grid Padding="0,6" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Key}" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
