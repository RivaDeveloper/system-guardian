<Page
    x:Class="Guardian.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Margin="40,24,40,32" Spacing="28" MaxWidth="1100" HorizontalAlignment="Left">

            <StackPanel Spacing="6">
                <TextBlock Text="SYSTEM CARE" Style="{StaticResource EyebrowStyle}" />
                <TextBlock Text="Your PC, in check." FontFamily="{StaticResource DisplayFont}" FontSize="78"
                           CharacterSpacing="10" LineHeight="80" TextWrapping="Wrap" />
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="16" MaxWidth="560" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Text="Scan for threats, keep drivers and apps current, and repair Windows. Nothing runs until you start it." />
            </StackPanel>

            <!-- Status cards -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="PROTECTION" Style="{StaticResource CardLabelStyle}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Ellipse x:Name="ProtectionDot" Width="10" Height="10" Fill="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProtectionValue" Grid.Column="1" Text="Checking…" Style="{StaticResource CardValueStyle}" />
                        </Grid>
                        <TextBlock x:Name="ProtectionDetail" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="DEFINITIONS" Style="{StaticResource CardLabelStyle}" />
                        <TextBlock x:Name="DefinitionsValue" Text="…" Style="{StaticResource CardValueStyle}" />
                        <TextBlock x:Name="DefinitionsDetail" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="PRIVILEGES" Style="{StaticResource CardLabelStyle}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Ellipse x:Name="AdminDot" Width="10" Height="10" VerticalAlignment="Center" />
                            <TextBlock x:Name="AdminValue" Grid.Column="1" Style="{StaticResource CardValueStyle}" />
                        </Grid>
                        <TextBlock x:Name="AdminDetail" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="UpdateButton" Content="Update virus definitions" Click="Update_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Refresh" Click="Refresh_Click" />
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
            </StackPanel>

            <!-- Shortcuts -->
            <StackPanel Spacing="12">
                <TextBlock Text="Get started" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource CardButton}" Tag="scan" Click="Shortcut_Click">
                        <StackPanel Spacing="12">
                            <Border Width="44" Height="44" CornerRadius="13">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#ff2e55" Offset="0" /><GradientStop Color="#ff7a59" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xEA18;" Foreground="White" FontSize="20" />
                            </Border>
                            <TextBlock Text="Scan for viruses" FontFamily="{StaticResource DisplayBoldFont}" FontSize="24" />
                            <TextBlock Text="Guardian deep scan, Defender and VirusTotal" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource CardButton}" Tag="drivers" Click="Shortcut_Click">
                        <StackPanel Spacing="12">
                            <Border Width="44" Height="44" CornerRadius="13">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8b6bff" Offset="0" /><GradientStop Color="#38d0ff" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE772;" Foreground="White" FontSize="20" />
                            </Border>
                            <TextBlock Text="Check drivers" FontFamily="{StaticResource DisplayBoldFont}" FontSize="24" />
                            <TextBlock Text="Find newer drivers via Windows Update" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource CardButton}" Tag="apps" Click="Shortcut_Click">
                        <StackPanel Spacing="12">
                            <Border Width="44" Height="44" CornerRadius="13">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#ff2e88" Offset="0" /><GradientStop Color="#8b6bff" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE71D;" Foreground="White" FontSize="20" />
                            </Border>
                            <TextBlock Text="Update apps" FontFamily="{StaticResource DisplayBoldFont}" FontSize="24" />
                            <TextBlock Text="See and install updates with winget" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Style="{StaticResource CardButton}" Tag="repair" Click="Shortcut_Click">
                        <StackPanel Spacing="12">
                            <Border Width="44" Height="44" CornerRadius="13">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2fd27a" Offset="0" /><GradientStop Color="#38d0ff" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE90F;" Foreground="White" FontSize="20" />
                            </Border>
                            <TextBlock Text="Repair Windows" FontFamily="{StaticResource DisplayBoldFont}" FontSize="24" />
                            <TextBlock Text="DISM and SFC system file repair" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
