<Page
    x:Class="Guardian.Pages.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Guardian.Services.Cleanup">
    <Grid Margin="40,28,40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="TUNE-UP" Style="{StaticResource EyebrowStyle}" />
            <TextBlock Text="Cleanup" Style="{StaticResource TitleTextBlockStyle}" />
        </StackPanel>

        <Pivot x:Name="CleanupPivot" Grid.Row="1">
            <PivotItem Header="Registry cleaner">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"
                               Text="Finds leftover entries that point at programs, uninstallers, fonts, COM objects, context-menu items and file types that no longer exist, in HKEY_LOCAL_MACHINE, HKEY_CURRENT_USER and HKEY_CLASSES_ROOT. Every fix is saved to a backup first, so you can undo it from the Restore tab." />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RegScanButton" Content="Scan registry" Click="RegScan_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="RegFixButton" Content="Fix selected" Click="RegFix_Click" IsEnabled="False" />
                        <ProgressRing x:Name="RegBusy" IsActive="False" Width="20" Height="20" />
                        <TextBlock x:Name="RegStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListView x:Name="RegList" Grid.Row="2" ItemsSource="{x:Bind RegIssues}" SelectionMode="Multiple"
                              SelectionChanged="RegList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:RegistryIssue">
                                <StackPanel Padding="0,6">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="3" x:Name="RegHint" Foreground="{StaticResource FaintBrush}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
            </PivotItem>

            <PivotItem Header="Junk files">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"
                               Text="Temporary files and caches that Windows and apps rebuild by themselves. Only files older than a day are removed. Your documents, downloads and the recycle bin are never touched." />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="JunkScanButton" Content="Scan for junk" Click="JunkScan_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="JunkCleanButton" Content="Clean selected" Click="JunkClean_Click" IsEnabled="False" />
                        <ProgressRing x:Name="JunkBusy" IsActive="False" Width="20" Height="20" />
                        <TextBlock x:Name="JunkStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListView x:Name="JunkList" Grid.Row="2" ItemsSource="{x:Bind JunkItems}" SelectionMode="Multiple"
                              SelectionChanged="JunkList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:JunkCategory">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" FontFamily="{StaticResource NumberFont}" FontSize="24"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Restore">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"
                               Text="Each registry fix keeps a backup. Pick one and restore it to put the entries back exactly as they were. Restoring machine-wide entries needs administrator rights." />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RestoreButton" Content="Restore selected" Click="Restore_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Open backups folder" Click="OpenBackups_Click" />
                        <TextBlock x:Name="RestoreStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListView x:Name="BackupList" Grid.Row="2" ItemsSource="{x:Bind Backups}" SelectionMode="Single"
                              SelectionChanged="BackupList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:RegistryBackup">
                                <TextBlock Text="{x:Bind Text}" Padding="0,8" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
