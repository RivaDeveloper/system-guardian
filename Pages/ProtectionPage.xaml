<Page
    x:Class="Guardian.Pages.ProtectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Guardian.Services.Protection">
    <ScrollViewer>
        <StackPanel Margin="40,28,40,40" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="REAL-TIME" Style="{StaticResource EyebrowStyle}" />
                <TextBlock Text="Protection" Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>

            <!-- Master switch and counters -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="StatusTitle" FontFamily="{StaticResource DisplayFont}" FontSize="34" CharacterSpacing="20" />
                            <TextBlock x:Name="StatusSub" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MasterSwitch" Grid.Column="1" OnContent="On" OffContent="Off" VerticalAlignment="Center" Toggled="Master_Toggled" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="FILES CHECKED" Style="{StaticResource CardLabelStyle}" /><TextBlock x:Name="CheckedText" Style="{StaticResource CardValueStyle}" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="THREATS FOUND" Style="{StaticResource CardLabelStyle}" /><TextBlock x:Name="ThreatsText" Style="{StaticResource CardValueStyle}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="QUARANTINED" Style="{StaticResource CardLabelStyle}" /><TextBlock x:Name="QuarantinedText" Style="{StaticResource CardValueStyle}" /></StackPanel>
                    </Grid>
                    <TextBlock x:Name="EngineText" Foreground="{StaticResource FaintBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Each protection feature has its own switch -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Shields" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,6" />
                    <Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Watch new files" /><TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Text="Checks every new program or script that appears in Downloads, the desktop, temp and startup folders. Documents and photos are never opened." /></StackPanel>
                        <ToggleSwitch x:Name="FilesSwitch" Grid.Column="1" Tag="files" OnContent="On" OffContent="Off" Toggled="Option_Toggled" /></Grid>
                    <Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Watch startup entries" /><TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Text="Alerts when something new is set to start with Windows, a favourite place for malware to survive a restart." /></StackPanel>
                        <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" Tag="startup" OnContent="On" OffContent="Off" Toggled="Option_Toggled" /></Grid>
                    <Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Check USB drives" /><TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Text="Looks at the programs and scripts on a USB stick or other removable drive when you plug it in." /></StackPanel>
                        <ToggleSwitch x:Name="UsbSwitch" Grid.Column="1" Tag="usb" OnContent="On" OffContent="Off" Toggled="Option_Toggled" /></Grid>
                    <Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Quarantine serious threats automatically" /><TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Text="Off: Guardian only alerts you and you decide. On: high-risk files are moved to quarantine straight away (always reversible)." /></StackPanel>
                        <ToggleSwitch x:Name="AutoSwitch" Grid.Column="1" Tag="auto" OnContent="On" OffContent="Off" Toggled="Option_Toggled" /></Grid>
                    <Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Check unknown programs on VirusTotal" /><TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Text="Sends only the file's fingerprint (never the file) for new unsigned programs. Needs your VirusTotal key in Settings." /></StackPanel>
                        <ToggleSwitch x:Name="CloudSwitch" Grid.Column="1" Tag="cloud" OnContent="On" OffContent="Off" Toggled="Option_Toggled" /></Grid>
                    <Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Scheduled deep scan" /><TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Text="Runs the full deep scan quietly in the background while Guardian is running." /></StackPanel>
                        <ComboBox x:Name="ScheduleBox" Grid.Column="1" Width="120" SelectionChanged="Schedule_Changed">
                            <ComboBoxItem Content="Off" /><ComboBoxItem Content="Daily" /><ComboBoxItem Content="Weekly" />
                        </ComboBox></Grid>
                    <Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Notifications" /><TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Text="Show a message from the taskbar icon when something is found." /></StackPanel>
                        <ToggleSwitch x:Name="NotifySwitch" Grid.Column="1" Tag="notify" OnContent="On" OffContent="Off" Toggled="Option_Toggled" /></Grid>
                    <Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Keep protecting when the window is closed" /><TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Text="Closing the window hides Guardian in the taskbar corner instead of quitting, so protection keeps running." /></StackPanel>
                        <ToggleSwitch x:Name="BackgroundSwitch" Grid.Column="1" Tag="background" OnContent="On" OffContent="Off" Toggled="Option_Toggled" /></Grid>
                    <Grid Padding="0,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Start Guardian with Windows" /><TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Text="Starts quietly in the taskbar corner when you sign in, so you are protected from the start." /></StackPanel>
                        <ToggleSwitch x:Name="AutoStartSwitch" Grid.Column="1" Tag="autostart" OnContent="On" OffContent="Off" Toggled="Option_Toggled" /></Grid>
                    <TextBlock Foreground="{StaticResource FaintBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Guardian protects your PC on its own and does not need Windows Defender. Its protection works in user mode: it checks files right after they appear, not before they run. With Defender on as well you get two independent layers." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Exclusions" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Folders Guardian's real-time protection leaves alone, for example a folder of your own tools." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add folder…" Click="AddExclusion_Click" />
                        <Button x:Name="RemoveExclusionButton" Content="Remove selected" Click="RemoveExclusion_Click" IsEnabled="False" />
                    </StackPanel>
                    <ListView x:Name="ExclusionList" ItemsSource="{x:Bind Exclusions}" SelectionMode="Single" MaxHeight="150"
                              SelectionChanged="ExclusionList_SelectionChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Protection history" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button Grid.Column="1" Content="Clear" Click="Clear_Click" />
                    </Grid>
                    <TextBlock x:Name="HistoryEmpty" Foreground="{StaticResource MutedBrush}" Text="Nothing yet. Alerts and checks appear here." />
                    <ListView ItemsSource="{x:Bind Events}" SelectionMode="None" MaxHeight="420">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:ProtectionEvent">
                                <Grid Padding="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Severity}" Foreground="{x:Bind SeverityBrush}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{x:Bind WhenText}" Opacity="0.6" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Detail}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ActionText}" Foreground="{x:Bind SeverityBrush}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="Quarantine" Visibility="{x:Bind CanQuarantine}" Click="EventQuarantine_Click" />
                                        <Button Content="It's fine" Visibility="{x:Bind CanQuarantine}" Click="EventAllow_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
