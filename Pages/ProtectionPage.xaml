<Page
    x:Class="Guardian.Pages.ProtectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Guardian.Services.Protection">
    <Page.Resources>
        <!-- one shield row: a tinted icon tile, a title with its explanation, and the switch -->
        <Style x:Key="RowIcon" TargetType="Border">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3Dff2e55" Offset="0" />
                        <GradientStop Color="#338b6bff" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource CardLabelStyle}">
            <Setter Property="Margin" Value="2,0,0,2" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="40,28,40,48" Spacing="18" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="REAL-TIME" Style="{StaticResource EyebrowStyle}" />
                <TextBlock Text="Protection" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Guardian's own shields. Every one has its own switch." />
            </StackPanel>

            <!-- Status: a glowing shield, the verdict, the master switch and the engine's size -->
            <Border CornerRadius="20" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="26">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2E8b6bff" Offset="0" />
                        <GradientStop Color="#16ff2e55" Offset="0.6" />
                        <GradientStop Color="#0Cffffff" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnSpacing="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="132" Height="132" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusHalo" Width="132" Height="132" Opacity="0.18" Fill="{StaticResource BgBrush}" />
                        <Ellipse Width="132" Height="132" StrokeThickness="1" Stroke="{StaticResource StrokeBrush}" />
                        <Ellipse Width="104" Height="104" StrokeThickness="1" StrokeDashArray="3 4" Stroke="{StaticResource StrokeBrush}" />
                        <Ellipse x:Name="StatusRing" Width="82" Height="82" StrokeThickness="3" Fill="#33000000" />
                        <FontIcon x:Name="StatusGlyph" Glyph="&#xE83D;" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StatusTitle" FontFamily="{StaticResource DisplayFont}" FontSize="48" CharacterSpacing="30" />
                        <TextBlock x:Name="StatusSub" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="EngineText" Foreground="{StaticResource FaintBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                        <TextBlock Text="REAL-TIME PROTECTION" Style="{StaticResource CardLabelStyle}" HorizontalAlignment="Center" />
                        <ToggleSwitch x:Name="MasterSwitch" OnContent="On" OffContent="Off" HorizontalAlignment="Center" Toggled="Master_Toggled" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Counters -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlassCard}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                        <StackPanel Grid.Column="1"><TextBlock Text="FILES CHECKED" Style="{StaticResource CardLabelStyle}" /><TextBlock x:Name="CheckedText" Style="{StaticResource CardValueStyle}" FontSize="34" /></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                        <StackPanel Grid.Column="1"><TextBlock Text="THREATS FOUND" Style="{StaticResource CardLabelStyle}" /><TextBlock x:Name="ThreatsText" Style="{StaticResource CardValueStyle}" FontSize="34" /></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                        <StackPanel Grid.Column="1"><TextBlock Text="IN QUARANTINE" Style="{StaticResource CardLabelStyle}" /><TextBlock x:Name="QuarantinedText" Style="{StaticResource CardValueStyle}" FontSize="34" /><HyperlinkButton Content="View and restore" Padding="0" Click="OpenQuarantine_Click" /></StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Watching -->
            <StackPanel Spacing="8">
                <TextBlock Text="WHAT GUARDIAN WATCHES" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource GlassCard}" Padding="22,10">
                    <StackPanel>
                        <Grid Padding="0,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="New files" Style="{StaticResource RowTitle}" /><TextBlock Style="{StaticResource RowText}" Text="Checks every new program or script that appears in Downloads, the desktop, temp and startup folders. Documents and photos are never opened." /></StackPanel>
                            <ToggleSwitch x:Name="FilesSwitch" Grid.Column="2" Tag="files" OnContent="On" OffContent="Off" VerticalAlignment="Center" Toggled="Option_Toggled" /></Grid>
                        <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" />
                        <Grid Padding="0,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE7E8;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Startup entries" Style="{StaticResource RowTitle}" /><TextBlock Style="{StaticResource RowText}" Text="Alerts when something new is set to start with Windows, a favourite place for malware to survive a restart." /></StackPanel>
                            <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2" Tag="startup" OnContent="On" OffContent="Off" VerticalAlignment="Center" Toggled="Option_Toggled" /></Grid>
                        <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" />
                        <Grid Padding="0,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE88E;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="USB drives" Style="{StaticResource RowTitle}" /><TextBlock Style="{StaticResource RowText}" Text="Looks at the programs and scripts on a USB stick or other removable drive when you plug it in." /></StackPanel>
                            <ToggleSwitch x:Name="UsbSwitch" Grid.Column="2" Tag="usb" OnContent="On" OffContent="Off" VerticalAlignment="Center" Toggled="Option_Toggled" /></Grid>
                        <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" />
                        <Grid Padding="0,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE756;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Programs as they start" Style="{StaticResource RowTitle}" /><TextBlock Style="{StaticResource RowText}" Text="Uses Windows' own kernel event feed to check every program within moments of it starting. Needs administrator rights." /><TextBlock x:Name="ProgramNote" Style="{StaticResource RowText}" Visibility="Collapsed" /></StackPanel>
                            <ToggleSwitch x:Name="ProgramsSwitch" Grid.Column="2" Tag="programs" OnContent="On" OffContent="Off" VerticalAlignment="Center" Toggled="Option_Toggled" /></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Reacting -->
            <StackPanel Spacing="8">
                <TextBlock Text="WHAT GUARDIAN DOES ABOUT IT" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource GlassCard}" Padding="22,10">
                    <StackPanel>
                        <Grid Padding="0,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE769;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Pause high-risk programs until I decide" Style="{StaticResource RowTitle}" /><TextBlock Style="{StaticResource RowText}" Text="Off by default. On: a program Guardian rates high-risk is paused right after it starts, and stays paused until you quarantine it or mark it as fine. A false alarm would freeze a good program." /></StackPanel>
                            <ToggleSwitch x:Name="PauseSwitch" Grid.Column="2" Tag="pause" OnContent="On" OffContent="Off" VerticalAlignment="Center" Toggled="Option_Toggled" /></Grid>
                        <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" />
                        <Grid Padding="0,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Quarantine serious threats automatically" Style="{StaticResource RowTitle}" /><TextBlock Style="{StaticResource RowText}" Text="Off: Guardian only alerts you and you decide. On: high-risk files are moved to quarantine straight away (always reversible)." /></StackPanel>
                            <ToggleSwitch x:Name="AutoSwitch" Grid.Column="2" Tag="auto" OnContent="On" OffContent="Off" VerticalAlignment="Center" Toggled="Option_Toggled" /></Grid>
                        <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" />
                        <Grid Padding="0,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE753;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Check unknown programs on VirusTotal" Style="{StaticResource RowTitle}" /><TextBlock Style="{StaticResource RowText}" Text="Sends only the file's fingerprint (never the file) for new unsigned programs. Needs your VirusTotal key in Settings." /></StackPanel>
                            <ToggleSwitch x:Name="CloudSwitch" Grid.Column="2" Tag="cloud" OnContent="On" OffContent="Off" VerticalAlignment="Center" Toggled="Option_Toggled" /></Grid>
                        <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" />
                        <Grid Padding="0,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE787;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Scheduled deep scan" Style="{StaticResource RowTitle}" /><TextBlock Style="{StaticResource RowText}" Text="Runs the full deep scan quietly in the background while Guardian is running." /></StackPanel>
                            <ComboBox x:Name="ScheduleBox" Grid.Column="2" Width="120" VerticalAlignment="Center" SelectionChanged="Schedule_Changed">
                                <ComboBoxItem Content="Off" /><ComboBoxItem Content="Daily" /><ComboBoxItem Content="Weekly" />
                            </ComboBox></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Background -->
            <StackPanel Spacing="8">
                <TextBlock Text="IN THE BACKGROUND" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource GlassCard}" Padding="22,10">
                    <StackPanel>
                        <Grid Padding="0,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xEA8F;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Notifications" Style="{StaticResource RowTitle}" /><TextBlock Style="{StaticResource RowText}" Text="Show a message from the taskbar icon when something is found." /></StackPanel>
                            <ToggleSwitch x:Name="NotifySwitch" Grid.Column="2" Tag="notify" OnContent="On" OffContent="Off" VerticalAlignment="Center" Toggled="Option_Toggled" /></Grid>
                        <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" />
                        <Grid Padding="0,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Keep protecting when the window is closed" Style="{StaticResource RowTitle}" /><TextBlock Style="{StaticResource RowText}" Text="Closing the window hides Guardian in the taskbar corner instead of quitting, so protection keeps running." /></StackPanel>
                            <ToggleSwitch x:Name="BackgroundSwitch" Grid.Column="2" Tag="background" OnContent="On" OffContent="Off" VerticalAlignment="Center" Toggled="Option_Toggled" /></Grid>
                        <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" />
                        <Grid Padding="0,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource RowIcon}"><FontIcon Glyph="&#xE768;" FontSize="18" Foreground="{StaticResource InkBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Start Guardian with Windows" Style="{StaticResource RowTitle}" /><TextBlock Style="{StaticResource RowText}" Text="Starts quietly in the taskbar corner when you sign in, so you are protected from the start." /></StackPanel>
                            <ToggleSwitch x:Name="AutoStartSwitch" Grid.Column="2" Tag="autostart" OnContent="On" OffContent="Off" VerticalAlignment="Center" Toggled="Option_Toggled" /></Grid>
                    </StackPanel>
                </Border>
                <TextBlock Foreground="{StaticResource FaintBrush}" FontSize="12" TextWrapping="Wrap" Margin="4,4,0,0"
                           Text="Guardian protects your PC on its own and does not need Windows Defender. Its protection works in user mode, not as a kernel driver: it checks files right after they appear and, as administrator, programs the moment they start. It can pause a risky program but cannot stop one before it begins. With Defender on as well you get two independent layers." />
            </StackPanel>

            <!-- Exclusions -->
            <StackPanel Spacing="8">
                <TextBlock Text="EXCLUSIONS" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Folders Guardian's real-time protection leaves alone, for example a folder of your own tools." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add folder…" Click="AddExclusion_Click" />
                            <Button x:Name="RemoveExclusionButton" Content="Remove selected" Click="RemoveExclusion_Click" IsEnabled="False" />
                        </StackPanel>
                        <ListView x:Name="ExclusionList" ItemsSource="{x:Bind Exclusions}" SelectionMode="Single" MaxHeight="150"
                                  SelectionChanged="ExclusionList_SelectionChanged" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- History -->
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="PROTECTION HISTORY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Clear" Click="Clear_Click" />
                </Grid>
                <Border Style="{StaticResource GlassCard}" Padding="14,10">
                    <StackPanel>
                        <TextBlock x:Name="HistoryEmpty" Foreground="{StaticResource MutedBrush}" Margin="6,8" Text="Nothing yet. Alerts and checks appear here." />
                        <ListView ItemsSource="{x:Bind Events}" SelectionMode="None" MaxHeight="460" Background="Transparent" BorderThickness="0" Padding="0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:ProtectionEvent">
                                    <Grid Padding="0,10" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="2" Background="{x:Bind SeverityBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Severity}" Foreground="{x:Bind SeverityBrush}" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="{x:Bind WhenText}" Opacity="0.6" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="Bold" />
                                            <TextBlock Text="{x:Bind Detail}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ActionText}" Foreground="{x:Bind SeverityBrush}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Quarantine" Visibility="{x:Bind CanQuarantine}" Click="EventQuarantine_Click" />
                                            <Button Content="It's fine" Visibility="{x:Bind CanQuarantine}" Click="EventAllow_Click" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
