<Page
    x:Class="Guardian.Pages.DebloatToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Guardian.Services.Tools">
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"
                   Text="Pre-installed apps and sponsored extras you probably never asked for. Only a short, hand-picked list is ever shown; Windows itself, the Store, Calculator, Photos and security components are never offered. Anything removed can be reinstalled from the Microsoft Store." />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ScanButton" Content="Find bloat" Click="Scan_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="RemoveButton" Content="Remove selected" Click="Remove_Click" IsEnabled="False" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <ListView x:Name="AppList" Grid.Row="2" ItemsSource="{x:Bind Items}" SelectionMode="Multiple"
                  SelectionChanged="AppList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:BloatApp">
                    <StackPanel Padding="0,6">
                        <TextBlock Text="{x:Bind Title}" />
                        <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
