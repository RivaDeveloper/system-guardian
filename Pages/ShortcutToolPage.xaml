<Page
    x:Class="Guardian.Pages.ShortcutToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Guardian.Services.Tools">
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"
                   Text="Finds desktop and Start menu shortcuts that point at programs or folders that no longer exist. If the program has simply moved (for example into a new version folder), Guardian can relink the shortcut. Removed shortcuts go to the Recycle Bin." />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ScanButton" Content="Scan shortcuts" Click="Scan_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="RepairButton" Content="Repair selected" Click="Repair_Click" IsEnabled="False" />
            <Button x:Name="RemoveButton" Content="Remove selected" Click="Remove_Click" IsEnabled="False" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <ListView x:Name="ShortcutList" Grid.Row="2" ItemsSource="{x:Bind Items}" SelectionMode="Multiple"
                  SelectionChanged="ShortcutList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:ShortcutItem">
                    <StackPanel Padding="0,6">
                        <TextBlock Text="{x:Bind Name}" />
                        <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
