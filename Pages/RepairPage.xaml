<Page
    x:Class="Guardian.Pages.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24,32,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="System repair" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="FullButton" Content="Run full repair (DISM, then SFC)" Click="Full_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="DismScanButton" Content="DISM scan" Click="DismScan_Click" />
            <Button x:Name="DismRestoreButton" Content="DISM repair" Click="DismRestore_Click" />
            <Button x:Name="SfcButton" Content="SFC scan" Click="Sfc_Click" />
            <Button x:Name="ChkdskButton" Content="CHKDSK scan" Click="Chkdsk_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" />
        </StackPanel>
        <TextBlock Grid.Row="3" TextWrapping="Wrap" Opacity="0.7"
                   Text="These are the same tools Microsoft documents for repairing Windows. They only change protected system files, never your own files. DISM can need a few minutes and an internet connection." />
        <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="Tool output" />
    </Grid>
</Page>
