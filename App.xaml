<Application
    x:Class="Guardian.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Lumen palette: #06070c base, violet + rose ambient light, #ff2e55 accent -->
            <Color x:Key="LumenBg">#06070c</Color>
            <Color x:Key="LumenAccent">#ff2e55</Color>
            <Color x:Key="LumenViolet">#8b6bff</Color>
            <Color x:Key="LumenGood">#46e08a</Color>
            <Color x:Key="LumenWarn">#ffb84a</Color>

            <SolidColorBrush x:Key="BgBrush" Color="#06070c" />
            <SolidColorBrush x:Key="InkBrush" Color="#eef0f7" />
            <SolidColorBrush x:Key="MutedBrush" Color="#a2a8bc" />
            <SolidColorBrush x:Key="FaintBrush" Color="#636a80" />
            <SolidColorBrush x:Key="AccentBrush" Color="#ff2e55" />
            <SolidColorBrush x:Key="GlassBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="GlassStrongBrush" Color="#B8101220" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#21FFFFFF" />

            <!-- Make every accent-driven control use Lumen red -->
            <Color x:Key="SystemAccentColor">#ff2e55</Color>
            <Color x:Key="SystemAccentColorLight1">#ff5f7e</Color>
            <Color x:Key="SystemAccentColorLight2">#ff8fa5</Color>
            <Color x:Key="SystemAccentColorLight3">#ffb8c6</Color>
            <Color x:Key="SystemAccentColorDark1">#e01f47</Color>
            <Color x:Key="SystemAccentColorDark2">#b8143a</Color>
            <Color x:Key="SystemAccentColorDark3">#8a0f2c</Color>

            <!-- Solid Lumen-red primary buttons with white text -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#ff2e55" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#ff5f7e" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#e01f47" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />

            <FontFamily x:Key="DisplayFont">ms-appx:///Assets/Fonts/BebasNeue-Regular.ttf#Bebas Neue</FontFamily>
            <FontFamily x:Key="DisplayBoldFont">ms-appx:///Assets/Fonts/BebasNeue-Regular.ttf#Bebas Neue</FontFamily>
            <FontFamily x:Key="NumberFont">ms-appx:///Assets/Fonts/BebasNeue-Regular.ttf#Bebas Neue</FontFamily>
            <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/Manrope-Regular.ttf#Manrope</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Manrope-Regular.ttf#Manrope</FontFamily>

            <x:Double x:Key="PivotHeaderItemFontSize">16</x:Double>
            <Thickness x:Key="PivotHeaderItemMargin">0,0,24,0</Thickness>
            <Thickness x:Key="PivotItemMargin">0,12,0,0</Thickness>
            <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>

            <!-- Navigation: transparent so the ambient background shows through -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            </Style>

            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="52" />
                <Setter Property="CharacterSpacing" Value="20" />
                <Setter Property="LineHeight" Value="52" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayBoldFont}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="CharacterSpacing" Value="20" />
            </Style>
            <Style x:Key="EyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="140" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Style>
            <Style x:Key="CardLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
            </Style>
            <Style x:Key="CardValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayBoldFont}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="CharacterSpacing" Value="20" />
            </Style>

            <!-- Frosted glass panel -->
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- Lists and log boxes become glass panels everywhere -->
            <Style TargetType="ListView">
                <Setter Property="Background" Value="{StaticResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="10,6" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <!-- Card-shaped button used for the overview shortcuts -->
            <Style x:Key="CardButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
