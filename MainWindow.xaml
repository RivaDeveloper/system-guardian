<Window
    x:Class="Guardian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Guardian"
    Title="Guardian">
    <Grid Background="{StaticResource BgBrush}">
        <!-- Ambient violet / rose light, same as the Lumen app -->
        <Image Source="ms-appx:///Assets/ambient.png" Stretch="UniformToFill" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Height="44" Padding="16,0,140,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:LumenOrb Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="guardian" VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}" FontSize="19" CharacterSpacing="-20" />
            </Grid>

            <InfoBar x:Name="AdminBar" Grid.Row="1" Margin="16,0,16,8" IsOpen="False" IsClosable="False" Severity="Warning"
                     Title="Not running as administrator"
                     Message="Driver updates and system file repair need administrator rights.">
                <InfoBar.ActionButton>
                    <Button Content="Restart as administrator" Click="Elevate_Click" Style="{StaticResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                            IsPaneToggleButtonVisible="False" IsSettingsVisible="True" OpenPaneLength="230"
                            SelectionChanged="Nav_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Overview" Tag="overview">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Virus scan" Tag="scan">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xEA18;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Drivers" Tag="drivers">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE772;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="App updates" Tag="apps">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="System repair" Tag="repair">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <Frame x:Name="ContentFrame" />
            </NavigationView>
        </Grid>
    </Grid>
</Window>
