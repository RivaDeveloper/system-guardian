# Copy this file to .env and fill it in. .env is ignored by git: never commit a token.
DISCORD_TOKEN=
GUILD_ID=

# Start in dry-run mode: the bot logs what it WOULD do but deletes, times out and answers nothing. Set to 0 once the log looks right.
DRY_RUN=1

# Optional: let Claude phrase answers from the server's guides (otherwise answers come straight from the guides, free).
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# AI_PER_USER_PER_HOUR=6

# Optional tuning (the defaults match the server layout)
# AUTO_ANSWER=1
# FORUM_ANSWERS=1
# STAFF_ROLES=Lumen Dev,Moderator
# MOD_LOG_CHANNEL=mod-log
# ANSWER_CHANNELS=general,lumen-chat,studios-chat,guardian-chat,android-and-tv,gaming,introductions
# ALLOWED_INVITES=76PgqgZgjV
# MENTION_LIMIT=5
